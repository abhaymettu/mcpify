{
  "name": "mcpify",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a closed Mac app into a tested MCP server. First target: Apple Notes.",
  "type": "module",
  "bin": {
    "mcpify": "src/cli.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/cli.ts serve notes",
    "test": "node --test --test-concurrency=1 test/",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
